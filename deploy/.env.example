# Copy to deploy/.env on the server. Never commit the real file.
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-64-hex-chars
PUBLIC_WS_URL=ws://72.61.214.92
FRONTEND_URL=http://72.61.214.92
CORS_ORIGINS=http://72.61.214.92
# "ac.id" accepts every Indonesian campus domain (ui.ac.id, student.itb.ac.id, ...)
ALLOWED_EMAIL_DOMAINS=ac.id
# No domain means no TLS: allow production over plain HTTP.
ALLOW_INSECURE_HTTP=true
COOKIE_SECURE=false
MAIL_MODE=console
SCHEDULER_ENABLED=true
# false = sign-up logs in immediately (no link). Email ownership is then not proven.
EMAIL_VERIFICATION=false
# KRS analysis with AI (optional). Free keys: Google AI Studio (Gemini) or console.groq.com.
# Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-flash-latest
# Groq:    AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=<model from the Groq console>
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-latest
